  </a>
{%- if codecov %}
  <a href="https://codecov.io/gh/{{ owner }}/{{ distribution }}">
    <img src="https://codecov.io/gh/{{ owner }}/{{ distribution }}/graph/badge.svg" alt="Codecov">
  </a>
{%- endif %}
{%- if pypi %}
  <a href="https://pypi.org/project/{{ distribution }}/">
    <img src="https://img.shields.io/pypi/v/{{ distribution }}" alt="PyPI">
  </a>
{%- endif %}
{%- if gh_ship %}
  <img src="https://img.shields.io/github/v/release/{{ owner }}/{{ distribution }}" alt="Release">
{%- endif %}
{%- if docs %}
  <a href="{{ docs_url }}">
    <img src="https://img.shields.io/badge/docs-{{ owner }}.github.io-blue" alt="Documentation">
  </a>
{%- endif %}
  <a href="https://github.com/j178/prek">
    <img src="https://img.shields.io/endpoint?url=https://raw.githubusercontent.com/j178/prek/master/docs/assets/badge-v0.json" alt="prek">
  </a>
  <img src="https://img.shields.io/github/license/{{ owner }}/{{ distribution }}" alt="License">
</p>

