{%- raw %}name: 🚀 Prepare Release
{%- endraw %}

# gh-ship's half of the contract is orchestration: it stages the branch,
# dispatches this workflow, reads the artifact it uploads, and renders the
# Release PR. Everything in between — what the next version is, what the
# changelog says, which files change — is this workflow's business, and here it
# is commitizen's.
{%- raw %}

on:
  workflow_dispatch:
    inputs:
      dry_run:
        description: Produce the artifact but commit and push nothing
        type: boolean
        default: false
      increment:
        description: Force an increment, or AUTO to derive it from the commits
        type: choice
        # `AUTO` rather than an empty option: GitHub renders an empty choice as
        # a blank line, actionlint rejects it, and commitizen rejects
        # `--increment ""`. One sentinel, spelled out.
        options: [AUTO, MAJOR, MINOR, PATCH]
        default: AUTO
  workflow_call:
    inputs:
      dry_run:
        type: boolean
        default: false

# Every API call here authenticates as the GitHub App, whose installation
# permissions apply instead of these. These cover `actions/checkout` alone.
permissions:
  contents: read

defaults:
  run:
    shell: bash

env:
  FORCE_COLOR: "1"

jobs:
  prepare:
    name: 🚀 Prepare
    runs-on: ubuntu-latest
    # APP_CLIENT_ID and APP_PRIVATE_KEY live only in this environment, and an
    # environment variable resolves only in a job that declares one — so this
    # key is load-bearing for authentication, not merely for gating. Preparing
    # a release is not a deployment; 📦 Publish Release is.
    environment:
      name: release
      deployment: false

    steps:
      # The push below must trigger ♻️ CI on the release branch, which the
      # default GITHUB_TOKEN cannot do. An App installation token can, and it
      # is revoked when this job ends.
      - uses: actions/create-github-app-token@v3
        id: app-token
        with:
          client-id: ${{ vars.APP_CLIENT_ID }}
          private-key: ${{ secrets.APP_PRIVATE_KEY }}

      - name: Read the App's user id
        id: bot
        run: echo "id=$(gh api "/users/${{ steps.app-token.outputs.app-slug }}[bot]" --jq .id)" >> "$GITHUB_OUTPUT"
        env:
          GH_TOKEN: ${{ steps.app-token.outputs.token }}

      - uses: actions/checkout@v7
        with:
          # Full history *and* tags: commitizen derives the next version from
          # the commits since the last tag, and a shallow clone has neither.
          fetch-depth: 0
          fetch-tags: true
          token: ${{ steps.app-token.outputs.token }}

      - uses: jdx/mise-action@v4
        with:
          # Keep in sync with PINNED_MISE_VERSION in ci.yaml.
          version: 2026.7.18
          cache: true
{%- endraw %}

      - name: Install the release tooling
{%- if is_pdm %}
        run: pdm install -G release
{%- else %}
        run: uv sync --group release
{%- endif %}

      # --- The version and the changelog are commitizen's ---------------------

      - name: Compute the next version
        id: version
        env:
          INCREMENT: {% raw %}${{ inputs.increment || 'AUTO' }}{% endraw %}
        run: |
          # `--get-next` prints the version the next bump would take and writes
          # nothing: no commit, no tag, no file. It exits non-zero when there is
          # nothing releasable, which is the common case on a quiet week and not
          # an error — so it is caught here rather than allowed to fail the job.
          args=(bump --get-next --yes)
          # `AUTO` means "no --increment at all", which is not the same as an
          # empty one: commitizen rejects `--increment ""` outright. The
          # `workflow_call` trigger declares no `increment` input, so the
          # default above also covers gh-ship dispatching this workflow.
          if [ "$INCREMENT" != "AUTO" ]; then
            args+=(--increment "$INCREMENT")
          fi

          if next="$({{ cz }} "${args[@]}" 2>/dev/null)"; then
            {
              echo "changed=true"
              echo "version=$next"
              # This project tags without a `v` prefix, so the tag and the
              # version are the same string. They stay separate outputs because
              # the release artifact keeps them separate: a tag convention is a
              # project's own choice, and gh-ship never derives one from the
              # other.
              echo "tag=$next"
            } >> "$GITHUB_OUTPUT"
            echo "Releasing → $next"
          else
            echo "changed=false" >> "$GITHUB_OUTPUT"
            echo "Nothing releasable since the last tag."
          fi

      - name: Bump and write the changelog
        if: steps.version.outputs.changed == 'true'
        env:
          VERSION: {% raw %}${{ steps.version.outputs.version }}{% endraw %}
        run: |
          # `--files-only`: bump the version in the files and write
          # CHANGELOG.md, but create no commit and no tag. gh-ship tags the
          # *merge commit* of the Release PR, so a tag created here would point
          # at a commit that may never be merged.
{%- if is_pdm %}
          # On this stack `version_provider = "scm"`, so there is no version
          # string in pyproject to rewrite and `--files-only` writes the
          # changelog and nothing else. That is correct, not a no-op: the tag
          # gh-ship creates later *is* the version.
{%- endif %}
          {{ cz }} bump --yes --files-only --changelog \
            --changelog-to-stdout "$VERSION" > "$RUNNER_TEMP/ship-notes.md"
{%- if not is_pdm %}

          # `project.version` moved, so uv.lock now records a stale version.
          uv lock
{%- endif %}

      - name: Commit and push
        if: {% raw %}${{ steps.version.outputs.changed == 'true' && !inputs.dry_run }}{% endraw %}
        env:
          APP_SLUG: {% raw %}${{ steps.app-token.outputs.app-slug }}{% endraw %}
          BOT_ID: {% raw %}${{ steps.bot.outputs.id }}{% endraw %}
          VERSION: {% raw %}${{ steps.version.outputs.version }}{% endraw %}
        run: |
          git config user.name "${APP_SLUG}[bot]"
          git config user.email "${BOT_ID}+${APP_SLUG}[bot]@users.noreply.github.com"

          git add -A
          # `chore(release): X` is deliberate, and load-bearing twice over. See
          # the `pull_request.title` comment in .github/ship.yml — the squash
          # commit is composed from that title, and this commit has to match it
          # for the same two reasons.
          git diff --cached --quiet || git commit -m "chore(release): ${VERSION}"
          git push origin HEAD

      # --- The protocol -------------------------------------------------------
      #
      # One artifact, named `ship-release`, containing one file. It is the only
      # channel between this workflow and gh-ship, and it is written on every
      # run — including the `changed: false` one, which is how gh-ship learns
      # there is nothing to release and exits 0.

      - name: Write the release artifact
        env:
          CHANGED: {% raw %}${{ steps.version.outputs.changed }}{% endraw %}
          VERSION: {% raw %}${{ steps.version.outputs.version }}{% endraw %}
          TAG: {% raw %}${{ steps.version.outputs.tag }}{% endraw %}
        run: |
          if [ "$CHANGED" != "true" ]; then
            jq -n '{schemaVersion: 1, changed: false}' > ship.release.json
          else
            jq -n \
              --arg version "$VERSION" \
              --arg tag "$TAG" \
              --rawfile notes "$RUNNER_TEMP/ship-notes.md" \
              '{
                "$schema": "https://noirbizarre.github.io/gh-ship/schema/release/v1.json",
                schemaVersion: 1,
                changed: true,
                version: $version,
                tag: $tag,
                release: { notes: $notes }
              }' > ship.release.json
          fi
          cat ship.release.json

      - name: Validate the release artifact
        env:
          GH_TOKEN: {% raw %}${{ steps.app-token.outputs.token }}{% endraw %}
        run: |
          gh extension install noirbizarre/gh-ship
          gh ship validate ship.release.json
{%- raw %}

      - uses: actions/upload-artifact@v7
        with:
          name: ship-release
          path: ship.release.json
          if-no-files-found: error
{%- endraw %}
