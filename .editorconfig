root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,py.jinja}]
indent_size = 4
max_line_length = 100

[*.{yml,yaml,toml,json}]
indent_size = 2

[{pyproject.toml,pyproject.toml.jinja}]
# Python tooling conventionally uses four-space indentation.
indent_size = 4

[*.{md,md.jinja}]
indent_size = 2
